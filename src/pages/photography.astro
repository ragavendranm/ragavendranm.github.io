---
import Layout from "../layouts/Layout.astro";
// Drop image files into /public/photos/ and reference them below,
// or switch to Astro's <Image> component for automatic optimization:
// import { Image } from "astro:assets";
---

<Layout title="Photography">
  <h1>Photography</h1>
  <p class="muted">A selection of personal work.</p>

  <div class="grid">
    <!-- Example placeholder tile — replace with real <img> or <Image> tags -->
    <div class="placeholder">Photo 1</div>
    <div class="placeholder">Photo 2</div>
    <div class="placeholder">Photo 3</div>
  </div>
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .placeholder {
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    border-radius: 6px;
  }
</style>
