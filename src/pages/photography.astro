---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import photoCaptions from "../data/photoCaptions.js";

// Drop image files directly into src/assets/photography/ — every one
// found there is automatically picked up, optimized, and rendered below.
// To add a caption/description/date, add a matching entry (by filename)
// in src/data/photoCaptions.js.
const photoModules = import.meta.glob("../assets/photography/*.{jpeg,jpg,png,webp}", {
  eager: true,
  import: "default",
});

const photos = Object.entries(photoModules).map(([path, image]) => {
  const filename = path.split("/").pop();
  const meta = photoCaptions[filename] || {};
  return {
    image,
    filename,
    caption: meta.caption,
    description: meta.description,
    date: meta.date ? new Date(meta.date) : null,
  };
});

// Newest first. Photos without a date (no entry in photoCaptions.js,
// or no `date` field set) sort to the end, alphabetically by filename.
photos.sort((a, b) => {
  if (a.date && b.date) return b.date.valueOf() - a.date.valueOf();
  if (a.date) return -1;
  if (b.date) return 1;
  return a.filename.localeCompare(b.filename);
});
---

<Layout title="Photography">
  <h1>Photography</h1>
  <p class="muted">A selection of my personal work.</p>

  {photos.length === 0 && (
    <p class="muted">
      No photos yet — add image files to <code>src/assets/photography/</code>.
    </p>
  )}

  <div class="grid">
    {photos.map((photo) => (
      <figure>
        <a href={photo.image.src} target="_blank" rel="noopener" class="thumb">
          <Image src={photo.image} alt={photo.caption ?? ""} width={800} />
        </a>
        {photo.caption && <figcaption class="caption">{photo.caption}</figcaption>}
        {photo.description && (
          <details>
            <summary>Details</summary>
            <p class="description">{photo.description}</p>
          </details>
        )}
      </figure>
    ))}
  </div>
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  figure {
    margin: 0;
  }

  /* The wrapper enforces the crop — not the <img> itself — so each
     photo's real (portrait/landscape/whatever) dimensions can't
     override the grid's consistent tile shape. */
  .thumb {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 6px;
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .caption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .description {
    color: var(--color-muted);
    font-size: 0.85rem;
    margin-top: 0.4rem;
  }

  details summary {
    cursor: pointer;
    color: var(--color-accent);
    font-size: 0.8rem;
    margin-top: 0.3rem;
    list-style: none;
  }

  details summary::-webkit-details-marker {
    display: none;
  }

  details summary::before {
    content: "+ ";
  }

  details[open] summary::before {
    content: "− ";
  }
</style>
