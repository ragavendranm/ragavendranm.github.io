---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Blog">
  <h1>Blog</h1>

  <ul>
    {posts.map((post) => (
      <li>
        <div class="post-header">
          <a href={`/blog/${post.id}`} class="post-title">{post.data.title}</a>
          <span class="muted post-date">
            {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}
          </span>
        </div>
        {post.data.summary && <p class="post-summary">{post.data.summary}</p>}
      </li>
    ))}
  </ul>
</Layout>

<style>
  ul {
    list-style: none;
    padding: 0;
  }

  li {
    margin-bottom: 1.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  li:last-child {
    border-bottom: none;
  }

  .post-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .post-date {
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .post-summary {
    margin-top: 0.5rem;
    color: var(--color-muted);
  }
</style>
